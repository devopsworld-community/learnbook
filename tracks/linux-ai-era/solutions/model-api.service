# /etc/systemd/system/model-api.service
# A llama.cpp server for the team's local model. Make it safe to leave running on a shared host.
[Unit]
Description=Model API (llama.cpp server)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/opt/llama.cpp/llama-server --host 127.0.0.1 --port 8080 -m /srv/models/model.gguf
DynamicUser=yes
SupplementaryGroups=video render
Restart=on-failure
RestartSec=5
MemoryHigh=28G
MemoryMax=32G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/srv/models

[Install]
WantedBy=multi-user.target

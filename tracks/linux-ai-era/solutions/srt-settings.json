{
  "network": {
    "allowedDomains": ["127.0.0.1", "localhost", "registry.npmjs.org", "pypi.org", "files.pythonhosted.org",
                       "github.com", "raw.githubusercontent.com", "objects.githubusercontent.com"],
    "deniedDomains": ["169.254.169.254", "metadata.google.internal", "*.amazonaws.com"],
    "allowLocalBinding": false
  },
  "filesystem": {
    "denyRead": ["~/.ssh", "~/.aws", "~/.kube", "~/.config/gh", "~/.config/gcloud", "~/.azure", "~/.netrc",
                 "~/.gnupg", "/etc/shadow", "/etc/sudoers", "/etc/ssh", "/var/run/docker.sock",
                 "**/.env", "**/.env.*", "**/*token*", "**/*secret*", "**/*credential*"],
    "allowWrite": [".", "/tmp/agent-work"],
    "denyWrite": ["~/.bashrc", "~/.profile", "~/.zshrc", "~/.gitconfig", ".git/hooks", "/etc"]
  }
}

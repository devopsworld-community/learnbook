# Agent box: the only place an agent runs with approval prompts relaxed.
# Non-root, no credentials baked in, tools pinned by the install scripts.
FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq make python3 python3-pip python3-venv pipx \
      shellcheck iproute2 procps less vim-tiny openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Node 22 for OpenCode
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 -s /bin/bash agent
USER agent
ENV PATH=/home/agent/.local/bin:/home/agent/.opencode/bin:$PATH
WORKDIR /home/agent

RUN curl -fsSL https://opencode.ai/install | bash \
 && pipx install llm && pipx inject llm llm-ollama \
 && pipx install checkov

# Agent rules travel with the box (build context is the repo root, see docker-compose.yml)
COPY --chown=agent:agent AGENTS.md /home/agent/AGENTS.md
COPY --chown=agent:agent setup/opencode.json /home/agent/.config/opencode/opencode.json

WORKDIR /work
CMD ["bash"]

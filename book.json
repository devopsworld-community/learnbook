 "tagline": "Read it, play it, run it.",
 "series": "DevOps World course series, 2026",
 "description": "One book, many tracks, one engine. Each track is a course from the DevOps World series: lessons you can read, exercises you play in the browser or in the terminal, and real labs whose result files count toward your progress. Every course starts at L0 (never done it) and ends at L3+ (runs it in production).",
 "ways": [
  {
   "name": "Play it in the browser",
   "how": "A local, gamified view: chapters unlock as you go, XP, spaced review and a delayed quiz.",
   "cmd": "make play"
  },
  {
   "name": "Work it in the terminal",
   "how": "Rustlings style: the next exercise opens, your file is re-checked on every save, you move on when it passes.",
   "cmd": "./lb watch"
  },
  {
   "name": "Read it as a book",
   "how": "Every chapter is a Markdown lesson in the repo, or export the whole track as one file.",
   "cmd": "./lb export md --out BOOK.md"
  },
  {
   "name": "Feed it to other tools",
   "how": "The same content as JSON for a content pipeline, an LMS, a community classroom or an AI tutor.",
   "cmd": "./lb export json --out track.json"
  },
  {
   "name": "Run the real labs",
   "how": "Docker, VMs and kind clusters. The game only clears lab rounds from the result files the labs leave behind.",
   "cmd": "make -C tracks/linux-ai-era lab01"
  }
